#%PAM-1.0
# Compatibility shim for the JumpCloud agent -- installed by jumpcloud-agent-bin.
#
# The agent only knows two PAM stack layouts: RHEL/Fedora (password-auth,
# system-auth) and Debian (common-auth). Arch has neither password-auth nor
# common-auth, so when console policy makes the agent write a line such as
#
#     auth substack password-auth
#
# into /etc/pam.d/sshd, PAM would reference a file that does not exist and
# authentication for that service breaks -- a real lockout path.
#
# Arch's system-auth carries the same four management groups as Fedora's
# password-auth, so mapping onto it keeps the agent's edits valid.
auth      include   system-auth
account   include   system-auth
password  include   system-auth
session   include   system-auth
